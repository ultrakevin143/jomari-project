# Local development only. Copy to .env or run npm run setup:local.
NODE_ENV=development
DATABASE_URL=postgresql://waste:local-development-only@127.0.0.1:54329/waste_hub?connection_limit=5&pool_timeout=10
DIRECT_URL=postgresql://waste:local-development-only@127.0.0.1:54329/waste_hub
PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://127.0.0.1:4000
SESSION_TTL_HOURS=12
# Set your own local seed password (at least 12 characters); setup:local generates one.
SEED_PASSWORD=
ALLOW_REMOTE_DATABASE=false
DEMO_MODE=true
